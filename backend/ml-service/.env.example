# ML Service Environment Variables

# Alpha Vantage API Key (free tier: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# CoinGecko — no key needed for free tier, but pro key if you have one
COINGECKO_API_KEY=

# Port for uvicorn
PORT=8000

# Spring Boot backend base URL (for inter-service calls if needed)
SPRING_BACKEND_URL=http://localhost:8080
